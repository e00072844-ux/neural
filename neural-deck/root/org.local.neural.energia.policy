<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NEURAL//DECK</vendor>
  <action id="org.local.neural.energia">
    <description>Cambiar el perfil de energía y los umbrales de la batería</description>
    <message>NEURAL//AJUSTES quiere cambiar el perfil de energía o los umbrales de carga de la batería.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/neural-energia</annotate>
  </action>
</policyconfig>
