<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <action id="org.local.neural.escudo">
    <description>Cambiar las reglas del cortafuegos desde NEURAL//ESCUDO</description>
    <message>NEURAL//ESCUDO quiere cambiar el cortafuegos</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/neural-escudo-ayudante</annotate>
  </action>
</policyconfig>
